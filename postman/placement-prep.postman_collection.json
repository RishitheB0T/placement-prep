                ]
              }
            }
          ]
        },
        {
          "name": "My profile (student)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"profile not complete yet\", () => pm.expect(pm.response.json().complete).to.eql(false));",
                  "pm.collectionVariables.set(\"studentId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Fill in my academic profile (student)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cgpa\": 8.4,\n  \"branch\": \"cse\",\n  \"tenthPercentage\": 91,\n  \"twelfthPercentage\": 88,\n  \"backlogs\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"now complete, branch stored in capitals\", () => {",
                  "  pm.expect(pm.response.json().complete).to.eql(true);",
                  "  pm.expect(pm.response.json().branch).to.eql(\"CSE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff profile as a student -> 403",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/me/staff-profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Officer\",\n  \"department\": null,\n  \"staffId\": null,\n  \"officeLocation\": null,\n  \"phoneNumber\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 Forbidden\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff profile as the admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
