              }
            ],
            "url": "{{baseUrl}}/api/users/me/staff-profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Training & Placement Officer\",\n  \"department\": \"TNP Cell\",\n  \"staffId\": null,\n  \"officeLocation\": \"Admin Block\",\n  \"phoneNumber\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
